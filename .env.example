# Supabase 專案設定（Supabase 後台 → Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 網站正式網址（供 sitemap、robots 與 Open Graph 使用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 站點個人資訊（顯示於首頁 Hero、頁尾、文章作者與社群分享圖）
NEXT_PUBLIC_SITE_AUTHOR=Bryan
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-github

# 雷達排程（只在伺服器端使用，切勿加上 NEXT_PUBLIC_ 前綴）
# Supabase 後台 → Project Settings → API → service_role（可略過 RLS，請妥善保管）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 驗證 Vercel Cron 請求，至少 16 個字元，可用 `openssl rand -hex 32` 產生
CRON_SECRET=your-cron-secret
# GitHub Fine-grained PAT，不需勾選任何權限（只讀取公開資料）
GITHUB_TOKEN=your-github-token
