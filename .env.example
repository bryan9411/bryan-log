# Supabase 專案設定（Supabase 後台 → Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 網站正式網址（供 sitemap、robots 與 Open Graph 使用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 站點個人資訊（顯示於首頁 Hero、頁尾、文章作者與社群分享圖）
NEXT_PUBLIC_SITE_AUTHOR=Bryan
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-github
NEXT_PUBLIC_HERO_HEADLINE=把複雜的系統，拆解成清楚的程式碼與文字
